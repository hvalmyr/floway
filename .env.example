# --- Postgres (used by docker-compose and backend) ---
POSTGRES_USER=floway
POSTGRES_PASSWORD=floway
POSTGRES_DB=floway
POSTGRES_PORT=5432

# --- Mailhog (local SMTP for testing lead notifications) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Backend (Go API) ---
APP_ENV=local
HTTP_PORT=8080
DATABASE_URL=postgres://floway:floway@localhost:5432/floway?sslmode=disable

# JWT signing secret for the admin panel session. Generate a real random value for anything beyond local dev.
JWT_SECRET=change-me-in-local-env

# Origin the frontend is served from (CORS allow-list for cookie-based admin auth).
# Must match how the browser actually reaches the frontend, incl. port.
FRONTEND_ORIGIN=http://localhost:3000

# SMTP (lead notifications). Point at mailhog locally.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@floway.local
NOTIFY_EMAIL_TO=

# Telegram Bot API (lead notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Garage (self-hosted S3-compatible object storage, для картинок) ---
# Ключи ниже используются и самим Garage (bootstrap в garage/entrypoint.sh),
# и бэкендом (S3-клиент). Сгенерируй реальные значения для чего-либо за
# пределами local dev, например: openssl rand -hex 12 / openssl rand -hex 25
GARAGE_ACCESS_KEY=GKdev00000000000000000
GARAGE_SECRET_KEY=devsecretkeydevsecretkeydevsecretkeydevsecretkey0
GARAGE_BUCKET=floway-uploads

# --- Frontend (Nuxt) ---
NUXT_PUBLIC_API_BASE=http://localhost:8080
# Host port the frontend container is published on (docker-compose)
FRONTEND_PORT=3000
