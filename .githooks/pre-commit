#!/usr/bin/env bash
# Pre-commit gate: formatter + linter + tests, scoped to whichever half of the
# monorepo (frontend/backend) actually has staged changes. Mirrors the checks
# in .github/workflows/ci.yml, minus the slow/heavy ones (go build -race,
# nuxt build, golangci-lint) that aren't practical to run on every commit.
#
# Enable with: just install-hooks   (or: git config core.hooksPath .githooks)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged_files="$(git diff --cached --name-only --diff-filter=ACM)"

frontend_changed=false
backend_changed=false
grep -q '^frontend/' <<<"$staged_files" && frontend_changed=true
grep -q '^backend/' <<<"$staged_files" && backend_changed=true

if [ "$frontend_changed" = true ]; then
  echo "==> frontend: format (oxfmt)"
  (cd frontend && bun run format)
  git add -u -- frontend

  echo "==> frontend: lint (oxlint)"
  (cd frontend && bun run lint)

  echo "==> frontend: test (vitest)"
  (cd frontend && bun run test)
fi

if [ "$backend_changed" = true ]; then
  echo "==> backend: format (gofmt)"
  (cd backend && gofmt -l -w .)
  git add -u -- backend

  echo "==> backend: vet (go vet)"
  (cd backend && go vet ./...)

  echo "==> backend: test (go test)"
  (cd backend && go test ./...)
fi

if [ "$frontend_changed" = false ] && [ "$backend_changed" = false ]; then
  echo "==> pre-commit: no frontend/ or backend/ changes staged, skipping checks"
fi
