{{ ansible_managed | comment }}
POSTGRES_USER={{ vault_postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB={{ vault_postgres_db }}

BACKEND_IMAGE={{ backend_image }}
FRONTEND_IMAGE={{ frontend_image }}
IMAGE_TAG={{ image_tag }}

JWT_SECRET={{ vault_jwt_secret }}
FLOWAY_DOMAIN={{ floway_domain }}

SMTP_HOST={{ vault_smtp_host }}
SMTP_PORT={{ vault_smtp_port }}
SMTP_FROM={{ vault_smtp_from }}
SMTP_USER={{ vault_smtp_user }}
SMTP_PASSWORD={{ vault_smtp_password }}
NOTIFY_EMAIL_TO={{ vault_notify_email_to }}

TELEGRAM_BOT_TOKEN={{ vault_telegram_bot_token }}
TELEGRAM_CHAT_ID={{ vault_telegram_chat_id }}
TELEGRAM_PROXY_URL={{ telegram_proxy_url }}
TELEGRAM_TUNNEL_HOST={{ vault_telegram_tunnel_host | default('') }}
TELEGRAM_TUNNEL_USER={{ vault_telegram_tunnel_user | default('') }}
TELEGRAM_TUNNEL_PORT={{ vault_telegram_tunnel_port | default('22') }}
# Активирует сайдкар telegram-proxy в docker-compose.prod.yml (см. README.md).
COMPOSE_PROFILES={{ 'telegram-proxy' if telegram_proxy_enabled else '' }}

GARAGE_ACCESS_KEY={{ vault_garage_access_key }}
GARAGE_SECRET_KEY={{ vault_garage_secret_key }}
GARAGE_BUCKET={{ vault_garage_bucket }}

NUXT_PUBLIC_YANDEX_METRIKA_ID={{ yandex_metrika_id }}
NUXT_PUBLIC_YANDEX_VERIFICATION={{ yandex_verification }}
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION={{ google_site_verification }}
