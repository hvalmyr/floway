{{ ansible_managed | comment }}
{
	email {{ caddy_acme_email }}
}

{{ floway_domain }} {
	encode zstd gzip

	# Security headers (Lighthouse "Best Practices"). Content-Security-Policy
	# is NOT here — frontend/'s nuxt.config.ts (nuxt-security module) sets it
	# per-request now, with a real nonce instead of 'unsafe-inline' in
	# script-src, which only the app itself can generate and stamp onto the
	# SSR HTML. That only covers the frontend: container's own responses;
	# /api/* and /uploads/* go straight to the backend and get no CSP header
	# at all now, same as before this change had any practical effect (CSP
	# on a JSON/file response doesn't do anything — it's only enforced
	# against the document that received it).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /healthz {
		reverse_proxy backend:8080
	}

	handle /uploads/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
{% for site in caddy_extra_sites | default([]) %}
{{ site.domain }} {
	encode zstd gzip

	# See the header block on the main domain above — Content-Security-Policy
	# comes from frontend-decor/'s own nuxt-security config the same way.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
	}

	handle /api/* {
		reverse_proxy {{ site.backend_addr }}
	}

	handle /healthz {
		reverse_proxy {{ site.backend_addr }}
	}

	handle /uploads/* {
		reverse_proxy {{ site.backend_addr }}
	}

	handle {
		reverse_proxy {{ site.frontend_addr }}
	}
}
{% endfor %}
