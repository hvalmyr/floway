{{ ansible_managed | comment }}
{
	email {{ caddy_acme_email }}
}

{{ floway_domain }} {
	encode zstd gzip

	# Security headers (Lighthouse "Best Practices"). script-src/style-src need
	# 'unsafe-inline' because Nuxt's SSR hydration payload and the Yandex
	# Metrika loader (useYandexMetrika.ts) are both inline, with no CSP nonce
	# wired up — removing it needs nonce support added to Nuxt first.
	# frame-src allows the Yandex Maps reviews widget (pages/index.vue) and
	# the CMS-editable contact map iframe (pages/contacts.vue); img-src stays
	# broad (https:) because admin content fields can hold legacy pasted
	# external image URLs.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self'; connect-src 'self' https://mc.yandex.ru; frame-src 'self' https://yandex.ru https://maps.yandex.ru; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /healthz {
		reverse_proxy backend:8080
	}

	handle /uploads/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
{% for site in caddy_extra_sites | default([]) %}
{{ site.domain }} {
	encode zstd gzip

	# See the header block on the main domain above for why 'unsafe-inline' is
	# needed. No frame-src allowance here — unlike the main site, this stack
	# embeds no iframes.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self'; connect-src 'self' https://mc.yandex.ru; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	handle /api/* {
		reverse_proxy {{ site.backend_addr }}
	}

	handle /healthz {
		reverse_proxy {{ site.backend_addr }}
	}

	handle /uploads/* {
		reverse_proxy {{ site.backend_addr }}
	}

	handle {
		reverse_proxy {{ site.frontend_addr }}
	}
}
{% endfor %}
