{{ ansible_managed | comment }}
{
	email {{ caddy_acme_email }}
}

{{ floway_domain }} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /healthz {
		reverse_proxy backend:8080
	}

	handle /uploads/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
{% for site in caddy_extra_sites | default([]) %}
{{ site.domain }} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {{ site.backend_addr }}
	}

	handle /healthz {
		reverse_proxy {{ site.backend_addr }}
	}

	handle /uploads/* {
		reverse_proxy {{ site.backend_addr }}
	}

	handle {
		reverse_proxy {{ site.frontend_addr }}
	}
}
{% endfor %}
